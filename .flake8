[flake8]
# E501 (line length) and W293 (whitespace on blank lines) are pervasive
# pre-existing style throughout this codebase, not something newly
# introduced here. E203 (whitespace before ':') is ignored because it
# conflicts with how black formats slices - a well-known incompatibility,
# see https://black.readthedocs.io/en/stable/the_black_code_style/current_style.html#slices
extend-ignore = E501, W293, E203
exclude = .venv, .git, __pycache__, .mypy_cache, .uv_cache, build, dist
