{
  "mcpServers": {
    "quri-sdk": {
      "command": "uv",
      "args": [
        "--directory",
        "/ABSOLUTE/PATH/TO/quri-sdk-mcp-server",
        "run",
        "python",
        "-m",
        "quri_sdk_mcp.server"
      ],
      "env": {
        "QURI_SDK_MCP_PYTHON": "/path/to/your/project/.venv/bin/python",
        "GITHUB_TOKEN": "ghp_..."
      }
    }
  }
}
